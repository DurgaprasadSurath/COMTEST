
put 1..127 into var
set the numberFormat to "hexadecimal"
put var into var2
repeat with each item of var2
	if item repeatindex() of var is between 1 and 9 then 
		delete every  occurrence of "0x" in it
		put "0" before it
	else		
		delete every  occurrence of "0x" in it
		put "h" after it
	end if
	log it
end repeat



