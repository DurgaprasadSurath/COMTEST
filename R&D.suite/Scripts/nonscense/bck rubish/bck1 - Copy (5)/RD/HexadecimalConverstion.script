	log it
end repeat



repeat 5 times
	if repeatIndex()  is between 1 and 9 then log "hi"
end repeat

log 1..9

enterDataByTabs ["Model1","Option1"]
to enterDataByTabs fieldValues
	repeat the number of items of fieldValues 
		typetext item repeatIndex() of  fieldValues, tabkey
	end repeat
	set the SearchRectangle to []
end enterDataByTabs


enterDataByTabs 6,"Model,Option,0"

to enterDataByTabs repeatTimes,fieldValues
	repeat repeatTimes times
		put repeatIndex() into IncrementValue
		
		repeat the number of items of fieldValues 
			TypeText item repeatIndex() of  fieldValues&IncrementValue, tabkey
		end repeat
	end repeat
	set the SearchRectangle to []
end enterDataByTabs