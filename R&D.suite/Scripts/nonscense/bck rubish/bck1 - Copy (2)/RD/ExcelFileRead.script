APItestcases "Data.xlsx","1"

to handle APItestcases
	params TestDataFile,SheetName
	set MyExcelFile to Workbook(ResourcePath(TestDataFile))
	set Sheet to worksheet(MyExcelFile,SheetName)
	Log Sheet's cell(1,1)
	Log the common date of Sheet's cell(2,1)
	Log the common date of Sheet's cell(3,1)
	Log the common date of  Sheet's cell(4,1)
	Log Sheet's cell(5,1)
	
end APItestcases


APItestcases "Data.xlsx","1"
//cell(6,1) contains ,,[a,b,c],d
to handle APItestcases
	params TestDataFile,SheetName
	set MyExcelFile to Workbook(ResourcePath(TestDataFile))
	set Sheet to worksheet(MyExcelFile,SheetName)
	put Sheet's cell(6,1) into temp
	//put [] into ListValues
	put "["&temp&"]"  into ListValues
	put ListValues as list into tewq
	log tewq
	repeat the number of items of tewq times
		log item repeatIndex() of tewq	
	end repeat
end APItestcases

















