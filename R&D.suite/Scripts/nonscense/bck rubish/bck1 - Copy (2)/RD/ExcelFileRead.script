to CharUsageStats  string

	repeat with each char of string
		add 1 to r's (it)
		log r's (it)
	end repeat
	
	return r
	
end CharUsageStats

CharUsageStats "repeat the number of lines of MyCSVfile times"
Log the result




set MyCSVfile to file ResourcePath("InitialToFinal_TestData_UAT.csv")

repeat the number of lines of MyCSVfile times
	repeat the number of items of line 1 of MyCSVfile
		put item repeatIndex() of line 1 of MyCSVfile into item repeatIndex() of global var
		set temp1 to repeatIndex()
		log var
		repeat the number of items of line  repeatIndex()+1  of MyCSVfile times
			log  item  repeatIndex()  of line  repeatIndex()+1 of MyCSVfile
			//set "Global"&&var to item  repeatIndex()   of line  repeatIndex()+1 of MyCSVfile
			
			//put item repeatIndex() of line repeatIndex()+1 of MyCSVfile into value("Global"&&var)
			Log "Global"&&var 
			if repeatIndex()  is greater than temp1 then
				exit repeat
			end if
		end repeat
		
	end repeat
	
end repeat


