to handle createRandomMail
	set Global NewGmailId to empty
	put a..z into Letters 
	put random(5,10) into NewGmailIdLength 
	repeat NewGmailIdLength times 
		put any item of letters after NewGmailId
	end repeat
	put NewGmailId&"@gmail.com" into Global NewGmailId
	Log Global NewGmailId
end createRandomMail

to handle createRandomPhone
	set Global NewPhoneNumber to 9
	put 0..9 into Digits 
	repeat 9 times 
		put any item of Digits after Global NewPhoneNumber
	end repeat
	Log Global NewPhoneNumber
end createRandomPhone





