to handle launch
	TypeText windowsKey,r
	TypeText "chrome https://ard.uchicago.edu/salesforce/",return
	set the SearchRectangle to SearchPortion.ScreenPart("BottomLeftQuadrant")
	if ImageFound(text:"MERGE FULL",caseSensitive:Yes, waitFor:20)
		Click text:"MERGE FULL",caseSensitive:Yes
	else
		//ScrollWheelDown 3
		TypeText pageDown
		Click text:"MERGE FULL",caseSensitive:Yes,waitFor:50
	end if
	set the SearchRectangle to [] 
	WaitFor 100, text:"UChicago account",SearchRectangle:SearchPortion.ScreenPart("VerticalMiddle")
end launch



