put firstBox// -- "a,b,c,d,e,f"

put secondBox //-- "9,8,7,6,Here"



to chooseContainer @c1, @c2

	if the number of items in c1 < number of items in c2
	
	then return container c1
	
	else return container c2

end chooseContainer

