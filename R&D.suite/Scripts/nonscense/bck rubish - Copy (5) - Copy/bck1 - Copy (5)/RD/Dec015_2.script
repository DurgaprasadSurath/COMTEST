put 40 / 10 into temp
put (40 rem 10) into temp2
put temp&temp2

//////////////////////////////////////////////////////////////////////////////////////////////////////

to handle mathPro_3 Number
	put the number of chars in Number into Count
	set TempNumber to 0
	repeat Count  times
		put (character repeatIndex() of Number)^repeatIndex() into item repeatIndex() of Temp
		put (item repeatIndex() of Temp + TempNumber) into TempNumber
	end repeat
	Log "The Final Result is"&&TempNumber
end mathPro_3

mathPro_3 1234

///////////////////////////////////////////////////////////////////////////////////////////////////////

//pass the logic as 1 or 2 u want and number list values you needed
to handle mathPro_4 logic,NumberofList 
	if logic is 1 then
		repeat NumberofList Times
			put repeatIndex()^2 + 1
		end repeat
	else if logic is 2 then
		repeat NumberofList Times
			put 2^repeatIndex() + (repeatIndex() - 1)
		end repeat
	end if
end mathPro_4

mathPro_4 2,10

