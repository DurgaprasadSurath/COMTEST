////////////////////////////////////////////////////////////////////////////////////////////////////////////////
to handle mathPro Number
	put the number of chars in Number into Count
	set CubedNumber to 0
	repeat Count times
		put (character repeatIndex() of Number)^3 into item repeatIndex() of Temp
		put (item repeatIndex() of Temp + CubedNumber) into CubedNumber
	end repeat
	if CubedNumber equal to Number then Log "Succes for"&& CubedNumber
end mathPro

mathPro 153

repeat 100000 times 
	mathPro repeatIndex()+100
end repeat

////////////////////////////////////////////////////////////////////////////////////////////////////////////////

to handle mathPro_2 Number
	put the number of chars in Number into Count
	set TempNumber to 0
	repeat Count - 1 times
		put (character repeatIndex() of Number) into item repeatIndex() of Temp
		put (item repeatIndex() of Temp + TempNumber) into TempNumber
	end repeat
	if TempNumber equal to character Count of Number then Log "Succes for"&& Number
end mathPro_2

mathPro_2 123

repeat 1000 times 
	mathPro_2 repeatIndex()+100
end repeat


