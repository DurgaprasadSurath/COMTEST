to handle addingTwoNumbers firstvalue,secondvalue
	set finalvalue to ""
	put firstvalue + secondvalue into finalvalue
	log "Adding two values final value is:"&finalvalue
end addingTwoNumbers

addingTwoNumbers 10,29

to handle addingTwoNumbers 
	set finalvalue to ""
	ask "What is the first value?"
	put it into firstvalue
	ask "What is the seecond value?"
	put it into secondvalue
	put (firstvalue + secondvalue) into finalvalue
	answer "Adding two values final value is:"&finalvalue
end addingTwoNumbers


to handle palindrome
	ask "Enter a word"
	put it into word_
	put reverse of word_ into rev_word
	if word_ = rev_word
		answer "Enterd word is palindrome"
	else
		answer "Entered word is not a palindrome"
	end if
end palindrome



function plural aWord
	if aWord ends with "s" then put "es" after aWord
	else if aWord ends with "y" then put "ies" into the last char of aWord
		else put "s" after aWord
	return aWord
end plural

