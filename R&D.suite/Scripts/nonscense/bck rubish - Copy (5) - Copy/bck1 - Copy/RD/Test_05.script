to handle FilterScrubbingReport
	Typetext Controlkey,a
	wait 1
	Typetext Controlkey,c
	Put RemoteClipboard() into MscrubbingMisc
	put CSVValue(MscrubbingMisc) into Mabc
	Put [] into global ScrubbingList
	//Log "MscrubbingMisc:"&Mabc
	repeat with each item of Mabc
		//Log it
		put it."Order Flag" into MFlag
		//log "MFlag:"&MFlag
		if MFlag is "Y"
			put it.Line into MlineNum
			log "MlineNum:"&MlineNum
			put it."Item Number" into MItem
			log "MItem:"&MItem
			put it."Ordered Quantity" into MOQ
			log "MOQ:"&MOQ
			Log "================="
			(*else is
        Log"There is no shipable item"*)
			
	Set ScrubbingDataFromApplication to {​​​​​SLine:MlineNum,SOrderedQuantity:MOQ,SItem:MItem}​​​​​
insert ScrubbingDataFromApplication into global ScrubbingList
end if
end repeat

Log "ScrubbingRpFromApp:"&global ScrubbingList
return global ScrubbingList
end FilterScrubbingReport
