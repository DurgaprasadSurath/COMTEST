to handle IncreasingQuantity_ScrubbingReport
	//Put FilterScrubbingReport() into VFilterScrubbingReport -- uncomment this line and comment below in th real execution
put[{​​​​​SItem:"81619A-FG", SLine:"1.1..1", SOrderedQuantity:"1"}​​​​​,{​​​​​SItem:"08164-90BC4", SLine:"1.1..3", SOrderedQuantity:"1"}​​​​​,{​​​​​SItem:"9320-6673", SLine:"1.1..4", SOrderedQuantity:"1"}​​​​​,{​​​​​SItem:"5061-7383", SLine:"1.1..5", SOrderedQuantity:"1"}​​​​​] into VFilterScrubbingReport




repeat with each item of VFilterScrubbingReport
	Put item repeatIndex() of VFilterScrubbingReport into MyFilterScrubbingReport
	put centerRight of ImageRectangle("BlueBar") into BlueBarCenter
	Log BlueBarCenter
	Put item 2 of BlueBarCenter into Cell_Y_Location
	
	Log Cell_Y_Location
	Put bottomCenter of imageRectangle(text:"Item") into ItemNumberBottom
	Put item 1 of ItemNumberBottom into ItemNumber_X_Location
	Put [ItemNumber_X_Location,Cell_Y_Location] into ItemNumberCellLocation
	Log "ItemNumberCellLocation:"&ItemNumberCellLocation
	Click ItemNumberCellLocation
	Typetext MyFilterScrubbingReport.SItem
	Typetext tabKey
	wait 3
	Put "AIWPF1" into global SubInventory
	Typetext global SubInventory
	Typetext tabkey
	wait 5
	hotkeys.OK
	wait 3
	Put "AIWPF1.%" into global Locator
	Typetext global Locator
	wait 3
	Typetext tabkey
	wait 9
	hotkeys.OK
	wait 2
	Typetext tabKey
	Typetext MyFilterScrubbingReport.SOrderedQuantity
	Typetext tabkey
	wait 1
	Typetext tabkey
	Typetext tabkey
	wait 1
	Typetext"Testing"
	wait 3
	if ImageFound("LotSerialEnabled")
		click FoundImageLocation()
		waitfor 50,text:"Serial Number"
		
		//do the step Need to write the steps below
		set SearchArea to [539,549,1141,809]
		tables.cellInitiateLookUp ("Start Serial Number"),("Serial Numbers"),(SearchArea)
		dataEntry.textBox ("Find"),("%")
		wait 3
		hotkeys.FIND
		wait 2
		(*navigation.button("MY") -- ADD NEW FUNCTION TO CHOOSE RANDOM ... *)
		hotkeys.OK
		put imagelocation(text:"Quantity") into TL
		set QT to readtext([TL.x+35,TL.y-10],[TL.x+80,TL.y+10])
		put imagelocation(text:"Quantity Entered") into TL
		set EQT to readtext([TL.x+55,TL.y-10],[TL.x+80,TL.y+10])
		if QT is equal to EQT then
			log "Both are same"
		else
			log "Quantity and Quantity Entered are not same"
		end if
		navigation.button("Done"),("Account Alias receipt")
		Typetext downArrow
		wait 3
	else if ImageFound("LotSerialDisabled")
		Typetext downArrow
		wait 3
		
		
	end if
	
end repeat

SearchRectangles.save

end IncreasingQuantity_ScrubbingReport




